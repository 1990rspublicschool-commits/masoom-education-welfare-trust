rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function hasRole(roles) {
      return signedIn() && request.auth.token.roles is list && request.auth.token.roles.hasAny(roles);
    }
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if hasRole(['SUPER_ADMIN', 'ADMIN', 'CONTENT_MANAGER', 'PROJECT_MANAGER'])
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /private/{allPaths=**} {
      allow read, write: if hasRole(['SUPER_ADMIN', 'ADMIN', 'FINANCE_MANAGER'])
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
