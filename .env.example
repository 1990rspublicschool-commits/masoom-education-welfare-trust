# Firebase web app configuration (public client values; restrict keys in Firebase console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Feature flag: international donations stay off until compliance is confirmed.
INTERNATIONAL_DONATIONS_ENABLED=false

# Payment and email integrations are intentionally unconfigured until providers are selected.
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=                 # server only; never use NEXT_PUBLIC_
# EMAIL_PROVIDER=
# EMAIL_API_KEY=                      # server only; never use NEXT_PUBLIC_
